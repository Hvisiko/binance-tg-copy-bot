# ==========================================
# 1. Telegram 機器人設定（必填，即可立即在 TG 接收即時交易通知）
# ==========================================
# 向 @BotFather 申請取得的 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# （選填）留空時，部署後第一個對機器人傳送 /start 的人會自動綁定並永久儲存為管理員！
TELEGRAM_CHAT_ID=

# ==========================================
# 2. 追蹤設定（可填多個，用逗號分隔；也可部署後直接在 TG 點選 /top 按鈕或貼網址新增）
# ==========================================
# 支援直接貼幣安帶單網址，或純數字 portfolioId
TRACKED_PORTFOLIOS=
# 輪詢間隔秒數（建議 5~10 秒，兼顧即時性與避免觸發幣安頻率限制）
POLL_INTERVAL_SEC=6
# （選填）若追蹤的交易員僅對登入用戶公開持倉，可填入瀏覽器 Cookie
BINANCE_WEB_COOKIE=

# ==========================================
# 3. 自動「限價單」跟單設定（預設 false 純通知模式，確認通知正常後可隨時在 TG 切換）
# ==========================================
ENABLE_AUTO_TRADE=false
# 是否使用幣安合約模擬網（Testnet）先行測試
BINANCE_USE_TESTNET=false

# 幣安 API Key（支援標準 HMAC，或免綁固定 IP 的 Ed25519 私鑰以相容 Zeabur 等雲端平台）
# 提示：部署後直接在 Telegram 私訊機器人輸入 /genkey 即可一鍵產生 Ed25519 公私鑰！
BINANCE_API_KEY=
# 若使用標準 HMAC Key 請填這欄（需固定 IP 白名單）：
BINANCE_API_SECRET=
# 若在雲端無固定 IP（如 Zeabur/Fly.io），請填 /genkey 產生的單行 PEM 私鑰：
BINANCE_ED25519_PRIVATE_KEY=

# 單筆跟單投入保證金（USDT）、單筆最大安全保證金上限（防大幣種最低名目價值超額）與槓桿倍數
TRADE_MARGIN_USDT=20
MAX_MARGIN_USDT=60
TRADE_LEVERAGE=10

# 限價單模式：
#   TARGET_PRICE  = 以「帶單員開倉價 ± 容許滑點%」掛 GTC 限價單（推薦）
#   POST_ONLY_BBO = 優先掛盤口買一/賣一 GTX Maker 單（若瞬間穿價自動降級限價保護）
LIMIT_ORDER_MODE=TARGET_PRICE
# 開倉容許最大正向滑點百分比（例如 0.08 代表最多容許比帶單員均價差 0.08%；設 0 代表嚴格同價）
LIMIT_SLIPPAGE_PCT=0.08
# 限價開倉單超過幾秒未成交就自動撤單（預設 180 秒；若帶單員提前平倉也會立即自動撤單）
LIMIT_ORDER_TIMEOUT_SEC=180
# 平倉模式：建議維持 MARKET（限價開倉控成本、市價平倉保命），若想強制平倉也用限價可改 LIMIT
EXIT_ORDER_TYPE=MARKET
